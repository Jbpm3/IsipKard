<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/container_img"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:clipToOutline="true">

    <!-- Front label -->
    <TextView
        android:id="@+id/tvFrontLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Question:"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Front EditText -->
    <EditText
        android:id="@+id/etCardFront"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@drawable/edittext_border"
        android:padding="12dp"
        android:inputType="text"
        android:textSize="15sp"
        android:textColor="#000000"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/tvFrontLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Back label -->
    <TextView
        android:id="@+id/tvBackLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Answer:"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/etCardFront"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Back EditText -->
    <EditText
        android:id="@+id/etCardBack"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@drawable/edittext_border"
        android:padding="12dp"
        android:inputType="text"
        android:textSize="15sp"
        android:textColor="#000000"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/tvBackLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Save Button -->
    <Button
        android:id="@+id/btnSaveCard"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:text="Save"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#148AD3"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/etCardBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnDeleteCard"/>

    <!-- Delete Button -->
    <Button
        android:id="@+id/btnDeleteCard"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:text="Delete"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#E53935"
        android:layout_marginTop="16dp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toBottomOf="@id/etCardBack"
        app:layout_constraintStart_toEndOf="@id/btnSaveCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
